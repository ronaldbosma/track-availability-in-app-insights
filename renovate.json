{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "replacements:all",
    "workarounds:all",
    "group:all"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "dotnet-sdk"
      ],
      "matchFileNames": [
        "src/logicApp/Functions/TrackAvailabilityInAppInsights.LogicApp.Functions.csproj",
        "src/logicApp/Functions.Tests/TrackAvailabilityInAppInsights.LogicApp.Functions.Tests.csproj"
      ],
      "allowedVersions": "10.*",
      "description": "Logic App custom code projects should use .NET 10."
    },
    {
      "matchPackageNames": [
        "Microsoft.Azure.Functions.Worker",
        "Microsoft.Azure.Functions.Worker.Sdk",
        "Microsoft.Extensions.Logging.Abstractions",
        "Microsoft.Extensions.Logging",
        "Azure.Identity"
      ],
      "matchFileNames": [
        "src/logicApp/Functions/TrackAvailabilityInAppInsights.LogicApp.Functions.csproj"
      ],
      "enabled": false,
      "description": "Disable updates for specific packages in Logic App custom code projects, because these require specific versions to match the Logic App runtime."
    },
    {
      "matchPackageNames": [
        "Microsoft.Azure.Workflows.WebJobs.Tests.Extension"
      ],
      "allowedVersions": "<=1.0.1",
      "description": "Microsoft.Azure.Workflows.WebJobs.Tests.Extension version 1.0.2 and 1.0.3 have a bug that causes the unit tests for the Logic App Workflows to fail. See https://github.com/Azure/logicapps/issues/1529"
    }
  ]
}
